{
  // Hand-written, never generated — an init command reaches for vinext on
  // Next.js projects, and this project is on OpenNext. See CLAUDE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flatbridge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "vars": {
        "NEXT_PUBLIC_FORMS_LIVE": "false"
      }
    }
  }
}
